{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "bin/${presetName}",
      "installDir": "bin/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_DEBUG": "Debug"
      }
    },
    
    {
        "name": "linux-base",
        "hidden": true,
        "generator": "Ninja",
        "binaryDir": "${sourceDir}/bin/build/${presetName}",
        "installDir": "${sourceDir}/bin/install/${presetName}",
        "cacheVariables": {
          "CMAKE_C_COMPILER": "/usr/bin/clang",
          "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
          "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/install/${presetName}"
        }
      },
    {
        "name": "x64-debug-lin",
        "displayName": "x64 Debug (Linux)",
        "inherits": "linux-base",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
        }
    },
    {
        "name": "x64-release-lin",
        "displayName": "x64 Release (Linux)",
        "inherits": "linux-base",
        "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release"
        }
    }
  ]
}