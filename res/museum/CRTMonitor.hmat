Resource(shader, "res://engine/shaders/deferred") : shader;
Resource(texture, "res://museum/CRTMonitor_t.png") : albedo;
Resource(texture, "res://museum/CRTMonitor_n.png") : normal;

Shader(resource = @shader);
Texture(binding = "albedo_tex", resource = @albedo, filter = NEAREST);
Texture(binding = "normal_tex", resource = @normal, filter = NEAREST);
Uniform()
{
    vec4("base_colour", [ 1, 1, 1, 1 ]);
    vec4("specular_colour", [ 1, 1, 1, 1 ]);
    
    float("roughness_factor_add", 0.65);
    float("normal_strength", 1.0);
};