Resource(mesh, "res://museum/Room01Concrete.obj") : room01_concrete_mesh;
Resource(material, "res://museum/ConcretePanels.hmat") : concrete_panels_mat;
Resource(mesh, "res://museum/Room01Bricks.obj") : room01_bricks_mesh;
Resource(material, "res://museum/BlackBricks.hmat") : black_bricks_mat;
Resource(mesh, "res://museum/Room01Bricks2.obj") : room01_bricks_2_mesh;
Resource(material, "res://museum/ClassicBricks.hmat") : classic_bricks_mat;
Resource(mesh, "res://museum/Room01Plaster.obj") : room01_plaster_mesh;
Resource(material, "res://museum/WhitePlaster.hmat") : white_plaster_mat;

Resource(mesh, "res://museum/PalmTree1.obj") : palm_tree_mesh;
Resource(mesh, "res://museum/PalmTree3.obj") : palm_tree_3_mesh;
Resource(material, "res://museum/PalmFrond.hmat") : palm_frond_mat;

Resource(mesh, "res://museum/Pedestal2.obj") : pedestal_short_mesh;
Resource(mesh, "res://museum/Pedestal3.obj") : pedestal_mesh;
Resource(mesh, "res://museum/Pedestal2.obj") : pedestal_medium_mesh;
Resource(material, "res://museum/Marble.hmat") : marble_mat;

Resource(mesh, "res://museum/Desk.obj") : desk_mesh;
Resource(material, "res://museum/Wood.hmat") : wood_mat;

Resource(mesh, "res://museum/PlanterEarth.obj") : planter_earth_mesh;
Resource(material, "res://museum/Earth.hmat") : earth_mat;
Resource(mesh, "res://museum/PlanterMarble.obj") : planter_marble_mesh;

Resource(mesh, "res://museum/PipeL.obj") : pipe_l_mesh;
Resource(mesh, "res://museum/PipeT.obj") : pipe_t_mesh;
Resource(mesh, "res://museum/Pipe20.obj") : pipe_20_mesh;
Resource(mesh, "res://museum/Pipe40.obj") : pipe_40_mesh;
Resource(mesh, "res://museum/PipeC.obj") : pipe_c_mesh;
Resource(material, "res://museum/ShinyPipes.hmat") : shiny_pipe_mat;

Resource(mesh, "res://museum/CRTMonitor.obj") : crt_mesh;
Resource(mesh, "res://museum/CRTMonitorScreen.obj") : crt_screen_mesh;
Resource(material, "res://museum/CRTMonitor.hmat") : crt_mat;
Resource(material, "res://museum/CRTMonitorScreen.hmat") : crt_screen_mat;

Resource(mesh, "res://museum/OrreryBase.obj") : orrery_base_mesh;
Resource(mesh, "res://museum/OrreryCore.obj") : orrery_core_mesh;
Resource(mesh, "res://museum/OrreryMid.obj") : orrery_mid_mesh;
Resource(mesh, "res://museum/OrreryOrbiterA.obj") : orrery_orbit_a_mesh;
Resource(mesh, "res://museum/OrreryOrbiterB.obj") : orrery_orbit_b_mesh;
Resource(material, "res://museum/Gold.hmat") : gold_mat;

Resource(render_graph, "res://museum/RenderGraph.hrgr") : render_graph;
Resource(texture, "res://samples/nasa_goddard_gaia_dr2_deep_star_map.png") : starry_backdrop;

// scene setup
Skybox(resource = @starry_backdrop);
AmbientLight([ 0.0156, 0.0117, 0.0039 ]);
RenderGraph(resource = @render_graph);

// objects
StaticMesh(mesh = @room01_concrete_mesh, material = @concrete_panels_mat);
StaticMesh(mesh = @room01_bricks_mesh, material = @black_bricks_mat);
StaticMesh(mesh = @room01_bricks_2_mesh, material = @classic_bricks_mat);
StaticMesh(mesh = @room01_plaster_mesh, material = @white_plaster_mat);

StaticMesh(mesh = @pedestal_medium_mesh, material = @marble_mat, position = [ 12, -4, 0 ]) : main_pedestal
{
    StaticMesh(mesh = @orrery_base_mesh, material = @gold_mat, position = [ 0, 0, 1.4 ])
    {
        StaticMesh(mesh = @orrery_mid_mesh, material = @gold_mat, position = [ 0, 0, 0.888 ]) : orrery_mid
        {
            StaticMesh(mesh = @orrery_core_mesh, material = @gold_mat) : orrery_core;
        };
        StaticMesh(mesh = @orrery_orbit_a_mesh, material = @gold_mat, position = [ 0, 0, 0 ]) : orrery_orbit_a;
        StaticMesh(mesh = @orrery_orbit_b_mesh, material = @gold_mat, position = [ 0, 0, 0 ]) : orrery_orbit_b;
    };
    TextBlock(text = "welcome to the museum!", tint = [ 1, 1, 1 ], euler = [ 90, 0, 0 ], position = [ -2.2, -0.5, 1.0 ]);
    TextBlock(text = "use WASD+QE to move", tint = [ 0.8, 0.8, 0.8 ], euler = [ 90, 0, 0 ], position = [ -0.9, -0.5, 0.65 ], scale = [ 0.5, 0.5, 0.5 ]);
    TextBlock(text = "right mouse drag to look around", tint = [ 0.8, 0.8, 0.8 ], euler = [ 90, 0, 0 ], position = [ -1.5, -0.5, 0.45 ], scale = [ 0.5, 0.5, 0.5 ]);
};
StaticMesh(mesh = @desk_mesh, material = @wood_mat, position = [ 15.2, -4, 0 ], euler = [ 0, 0, 180 ]);
StaticMesh(mesh = @crt_mesh, material = @crt_mat, position = [ 15.0, -3.4, 0.8 ], euler = [ 0, 0, 180 ]);
StaticMesh(mesh = @crt_screen_mesh, material = @crt_screen_mat, position = [ 15.0, -3.4, 0.8 ], euler = [ 0, 0, 180 ]) : crt_screen;

StaticMesh(mesh = @planter_marble_mesh, material = @marble_mat, position = [ 14, 0, 0 ])
{
    StaticMesh(mesh = @palm_tree_3_mesh, material = @palm_frond_mat, position = [ 0, 0, 0.9 ], scale = [ 0.67, 0.67, 0.67]);
    StaticMesh(mesh = @planter_earth_mesh, material = @earth_mat);
};
StaticMesh(mesh = @planter_marble_mesh, material = @marble_mat, position = [ 10, 0, 0 ])
{
    StaticMesh(mesh = @palm_tree_3_mesh, material = @palm_frond_mat, position = [ 0, 0, 0.9 ], scale = [ 0.67, 0.67, 0.67], euler = [ 0, 0, -66 ]);
    StaticMesh(mesh = @planter_earth_mesh, material = @earth_mat);
};

StaticMesh(mesh = @planter_marble_mesh, material = @marble_mat, position = [ 0, 0, -0.5 ])
{
    StaticMesh(mesh = @palm_tree_mesh, material = @palm_frond_mat, position = [ 0, 0, 0.9 ], scale = [ 0.9, 0.9, 0.9]);
    StaticMesh(mesh = @planter_earth_mesh, material = @earth_mat);
};
TextBlock(text = "all programming and art by", tint = [ 0.008, 0.016, 0.078 ], euler = [ 90, 0, 90 ], position = [ -2.6, -7.6, 2.2 ], scale = [ 0.5, 0.5, 0.5 ]);
TextBlock(text = "Cassette Costen", tint = [ 0.545, 0.243, 0.000 ], euler = [ 90, 0, 90 ], position = [ -2.6, -6.2, 2.0 ]);

StaticMesh(mesh = @pedestal_short_mesh, material = @marble_mat, position = [ -2, 24, -0.4 ]);
StaticMesh(mesh = @pedestal_short_mesh, material = @marble_mat, position = [ 2, 24, -0.4 ]);

StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 7, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 9, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 11, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 13, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 15, -11, 0 ]);

StaticMesh(mesh = @pipe_40_mesh, material = @shiny_pipe_mat, position = [ 15.3, -1.7, -0.5 ]);
StaticMesh(mesh = @pipe_40_mesh, material = @shiny_pipe_mat, position = [ 15.3, -1.7, 1.5 ]);
StaticMesh(mesh = @pipe_t_mesh, material = @shiny_pipe_mat, position = [ 15.3, -1.7, 3.5 ]);
StaticMesh(mesh = @pipe_l_mesh, material = @shiny_pipe_mat, position = [ 15.3, -2.2, 4.0 ], euler = [ 90, -90, 0 ]);
StaticMesh(mesh = @pipe_20_mesh, material = @shiny_pipe_mat, position = [ 15.8, -2.7, 4.0 ], euler = [ 0, 90, 0 ]);
StaticMesh(mesh = @pipe_40_mesh, material = @shiny_pipe_mat, position = [ 15.3, -1.2, 4.0 ], euler = [ -90, 0, 0 ]);
StaticMesh(mesh = @pipe_l_mesh, material = @shiny_pipe_mat, position = [ 15.3, 0.8, 4.0 ], euler = [ -90, -90, 0 ]);
StaticMesh(mesh = @pipe_40_mesh, material = @shiny_pipe_mat, position = [ 14.8, 1.3, 4.0 ], euler = [ -90, 0, 90 ]);
StaticMesh(mesh = @pipe_l_mesh, material = @shiny_pipe_mat, position = [ 12.3, 1.8, 4.0 ], euler = [ -90, -90, 180 ]);
StaticMesh(mesh = @pipe_c_mesh, material = @shiny_pipe_mat, position = [ 12.3, 1.8, 4.0 ], euler = [ -90, 90, 0 ]);
StaticMesh(mesh = @pipe_l_mesh, material = @shiny_pipe_mat, position = [ 8.4, -0.5, 0 ], euler = [ -180, 180, 90 ]);

Light(type = DIRECTIONAL, position = [ 1, 0, 2 ], euler = [ 15, 30, 0 ], colour = [ 1.4, 1.3, 1.2 ]);
Camera(slot = 0, position = [ 12, -9, 1.73 ], euler = [ 90, 0, 0 ], fov = 60)
{
    Light(type = POINT, colour = [ 0.5, 0.5, 0.5 ]);
};
