Resource(mesh, "res://museum/Room01Concrete.obj") : room01_concrete_mesh;
Resource(material, "res://museum/ConcretePanels.hmat") : concrete_panels_mat;
Resource(mesh, "res://museum/Room01Bricks.obj") : room01_bricks_mesh;
Resource(material, "res://museum/BlackBricks.hmat") : black_bricks_mat;
Resource(mesh, "res://museum/Room01Bricks2.obj") : room01_bricks_2_mesh;
Resource(material, "res://museum/ClassicBricks.hmat") : classic_bricks_mat;
Resource(mesh, "res://museum/Room01Plaster.obj") : room01_plaster_mesh;
Resource(material, "res://museum/WhitePlaster.hmat") : white_plaster_mat;

Resource(mesh, "res://museum/PalmTree1.obj") : palm_tree_mesh;
Resource(mesh, "res://museum/PalmTree3.obj") : palm_tree_3_mesh;
Resource(material, "res://museum/PalmFrond.hmat") : palm_frond_mat;

Resource(mesh, "res://museum/Pedestal2.obj") : pedestal_short_mesh;
Resource(mesh, "res://museum/Pedestal3.obj") : pedestal_mesh;
Resource(mesh, "res://museum/Pedestal2.obj") : pedestal_medium_mesh;
Resource(material, "res://museum/Marble.hmat") : marble_mat;

Resource(mesh, "res://museum/Desk.obj") : desk_mesh;
Resource(material, "res://museum/Wood.hmat") : wood_mat;

Resource(mesh, "res://museum/PlanterEarth.obj") : planter_earth_mesh;
Resource(material, "res://museum/Earth.hmat") : earth_mat;
Resource(mesh, "res://museum/PlanterMarble.obj") : planter_marble_mesh;

Resource(render_graph, "res://museum/RenderGraph.hrgr") : render_graph;
Resource(texture, "res://samples/nasa_goddard_gaia_dr2_deep_star_map.png") : starry_backdrop;

// scene setup
Skybox(resource = @starry_backdrop);
AmbientLight([ 0.0156, 0.0117, 0.0039 ]);
RenderGraph(resource = @render_graph);

// objects
StaticMesh(mesh = @room01_concrete_mesh, material = @concrete_panels_mat);
StaticMesh(mesh = @room01_bricks_mesh, material = @black_bricks_mat);
StaticMesh(mesh = @room01_bricks_2_mesh, material = @classic_bricks_mat);
StaticMesh(mesh = @room01_plaster_mesh, material = @white_plaster_mat);

StaticMesh(mesh = @pedestal_medium_mesh, material = @marble_mat, position = [ 12, -4, 0 ]);
StaticMesh(mesh = @desk_mesh, material = @wood_mat, position = [ 15.2, -4, 0 ], euler = [ 0, 0, 180 ]);

StaticMesh(mesh = @planter_marble_mesh, material = @marble_mat, position = [ 14, 0, 0 ])
{
    StaticMesh(mesh = @palm_tree_3_mesh, material = @palm_frond_mat, position = [ 0, 0, 0.9 ], scale = [ 0.67, 0.67, 0.67]);
    StaticMesh(mesh = @planter_earth_mesh, material = @earth_mat);
};
StaticMesh(mesh = @planter_marble_mesh, material = @marble_mat, position = [ 10, 0, 0 ])
{
    StaticMesh(mesh = @palm_tree_3_mesh, material = @palm_frond_mat, position = [ 0, 0, 0.9 ], scale = [ 0.67, 0.67, 0.67], euler = [ 0, 0, -66 ]);
    StaticMesh(mesh = @planter_earth_mesh, material = @earth_mat);
};

StaticMesh(mesh = @planter_marble_mesh, material = @marble_mat, position = [ 0, 0, -0.5 ])
{
    StaticMesh(mesh = @palm_tree_mesh, material = @palm_frond_mat, position = [ 0, 0, 0.9 ], scale = [ 0.9, 0.9, 0.9]);
    StaticMesh(mesh = @planter_earth_mesh, material = @earth_mat);
};

StaticMesh(mesh = @pedestal_short_mesh, material = @marble_mat, position = [ -2, 24, -0.4 ]);
StaticMesh(mesh = @pedestal_short_mesh, material = @marble_mat, position = [ 2, 24, -0.4 ]);

StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 7, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 9, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 11, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 13, -11, 0 ]);
StaticMesh(mesh = @pedestal_mesh, material = @marble_mat, position = [ 15, -11, 0 ]);


Light(type = DIRECTIONAL, position = [ 1, 0, 2 ], euler = [ 15, 30, 0 ], colour = [ 1, 1, 1 ]);
Camera(slot = 0, position = [ 12, -9, 1.73 ], euler = [ 90, 0, 0 ], fov = 60)
{
    Light(type = POINT, colour = [ 0.5, 0.5, 0.5 ]);
};
