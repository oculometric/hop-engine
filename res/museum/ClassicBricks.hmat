Resource(shader, "res://engine/shaders/pbr") : shader;
Resource(texture, "res://museum/ClassicBricks_t.png") : albedo;
Resource(texture, "res://museum/ClassicBricks_n.png") : normal;

Shader(resource = @shader);
Texture(binding = "albedo_tex", resource = @albedo, filter = NEAREST);
Texture(binding = "normal_map", resource = @normal, filter = NEAREST);
Uniform()
{
    vec4("diffuse", [ 1, 1, 1, 1 ]);
    vec4("specular", [ 1, 1, 1, 1 ]);
    vec4("emissive", [ 0, 0, 0, 0 ]);
    float("specular_exponent", 16);
    float("specular_factor", 0.2);
    float("use_triplanar", 1);
    float("triplanar_scale", 0.25);
};