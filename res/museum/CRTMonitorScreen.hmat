Resource(shader, "res://engine/shaders/deferred.glsl") : shader;

Shader(resource = @shader);
Uniform()
{
    vec4("base_colour", [ 1, 0, 1, 1 ]);
    vec4("specular_colour", [ 0, 0, 0, 0 ]);
    
    float("roughness_factor_add", 1.0);
    float("normal_strength", 1.0);
    float("emission_strength", 1.0);
};